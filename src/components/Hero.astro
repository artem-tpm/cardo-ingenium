---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="relative px-6 pt-40 pb-24 border-b border-[#dde1e6]">
  <div class="mx-auto max-w-4xl text-center">
    <div class="flex flex-col items-center gap-4 mb-8">
      <svg width="36" height="36" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="26" height="26" stroke="#16202b" stroke-width="1.5"/>
        <line x1="13" y1="3" x2="13" y2="29" stroke="#c9a86a" stroke-width="1.5"/>
        <line x1="3" y1="20" x2="29" y2="20" stroke="#16202b" stroke-width="1.5"/>
      </svg>
      <div class="flex items-center gap-3 font-serif-heading text-lg sm:text-xl tracking-[0.16em] uppercase text-[#16202b]">
        <span>Cardo</span>
        <span class="w-px h-4 bg-[#c9a86a]"></span>
        <span>Ingenium</span>
      </div>
      <p class="eyebrow text-[11px] tracking-[0.3em] uppercase text-[#1c3d3a]">{t.hero.tagline}</p>
    </div>
    <h1 class="font-serif-heading text-4xl sm:text-6xl leading-tight text-[#16202b]">
      {t.hero.h1}
    </h1>
    <p class="mt-6 text-lg text-[#59636f] max-w-2xl mx-auto">
      {t.hero.sub}
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-sm bg-[#1c3d3a] px-6 py-3 text-sm font-medium text-white hover:bg-[#142b29] transition-colors"
      >
        {t.hero.ctaPrimary}
      </a>
      <a
        href="#services"
        class="inline-flex items-center gap-2 rounded-sm border border-[#dde1e6] px-6 py-3 text-sm font-medium text-[#16202b] hover:border-[#1c3d3a] hover:text-[#1c3d3a] transition-colors"
      >
        {t.hero.ctaSecondary}
      </a>
    </div>
  </div>
  <div class="reveal mx-auto max-w-4xl mt-20 grid grid-cols-3 divide-x divide-[#dde1e6] border-t border-[#dde1e6] pt-8">
    {t.hero.stats.map((stat) => (
      <div class="text-center px-4">
        <p class="font-serif-heading text-2xl sm:text-3xl text-[#16202b]">{stat.num}</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-[#59636f]">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="relative px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl mb-16">
      <h2 class="eyebrow text-xs font-semibold uppercase text-[#8a6d3b] mb-3">{t.services.eyebrow}</h2>
      <h3 class="font-serif-heading text-2xl sm:text-4xl text-[#16202b]">{t.services.h2}</h3>
      <p class="mt-4 text-[#59636f]">{t.services.sub}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-[#dde1e6]">
      {t.services.items.map((service) => (
        <div class="reveal card-elevate border-r border-b border-[#dde1e6] bg-white p-6">
          <h4 class="font-serif-heading text-base text-[#16202b] mb-3">{service.title}</h4>
          <p class="text-sm text-[#59636f] leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Audience from "./Audience.astro";
import Process from "./Process.astro";
import Services from "./Services.astro";
import Engagement from "./Engagement.astro";
import Team from "./Team.astro";
import FAQ from "./FAQ.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Audience lang={lang} />
    <Process lang={lang} />
    <Services lang={lang} />
    <Engagement lang={lang} />
    <Team lang={lang} />
    <FAQ lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

---
const team = [
  {
    role: "Technical Product Manager",
    tag: "Product & Delivery",
    bio:
      "20+ years in IT spanning network engineering to delivery management at a global software company. Owns the product side of an engagement — scoping, stakeholder alignment, and delivery against acceptance criteria.",
  },
  {
    role: "Software Architect",
    tag: "Architecture & Engineering",
    bio:
      "10+ years as a software architect and 20+ years writing production code, across a wide portfolio of technology stacks. Owns the technical side — system design, architectural trade-offs, and engineering feasibility.",
  },
];
---

<section id="team" class="relative px-6 py-28 mesh-bg">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center max-w-2xl mx-auto mb-16">
      <h2 class="eyebrow text-xs font-semibold uppercase text-[#a1652f] mb-3">Team</h2>
      <h3 class="font-serif-heading text-2xl sm:text-4xl text-[#211f1a]">Who you'll work with.</h3>
      <p class="mt-4 text-[#63604f]">
        A two-person practice, by design — every engagement gets both the product
        and architecture perspective directly, not filtered through account layers.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 gap-6">
      {team.map((member) => (
        <div class="reveal card-elevate card-sheen spotlight rounded-2xl border border-[#dedac9] bg-white p-8">
          <p class="eyebrow text-xs font-semibold uppercase text-[#a1652f] mb-2">{member.tag}</p>
          <h4 class="font-serif-heading text-xl text-[#211f1a] mb-3">{member.role}</h4>
          <p class="text-sm text-[#63604f] leading-relaxed">{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

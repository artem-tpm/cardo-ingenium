---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="team" class="relative px-6 py-24 bg-[#f5f6f7] border-y border-[#dde1e6]">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl mb-16">
      <h2 class="eyebrow text-xs font-semibold uppercase text-[#8a6d3b] mb-3">{t.team.eyebrow}</h2>
      <h3 class="font-serif-heading text-2xl sm:text-4xl text-[#16202b]">{t.team.h2}</h3>
      <p class="mt-4 text-[#59636f]">{t.team.sub}</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-px bg-[#dde1e6]">
      {t.team.members.map((member) => (
        <div class="reveal bg-white p-8">
          <p class="eyebrow text-xs font-semibold uppercase text-[#8a6d3b] mb-2">{member.tag}</p>
          <h4 class="font-serif-heading text-xl text-[#16202b] mb-3">{member.role}</h4>
          <p class="text-sm text-[#59636f] leading-relaxed">{member.bio}</p>
          <ul class="mt-5 flex flex-col gap-2.5 border-t border-[#dde1e6] pt-5">
            {member.highlights.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-[#59636f] leading-relaxed">
                <span class="mt-2 h-1 w-1 shrink-0 bg-[#c9a86a]"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

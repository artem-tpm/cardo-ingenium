---
import { languages, type Lang } from "../i18n/ui";
import { localizedPath } from "../i18n/utils";

interface Props {
  lang: Lang;
  variant?: "desktop" | "mobile";
}

const { lang, variant = "desktop" } = Astro.props;

// Strip the current locale prefix from the path so switching preserves the
// current page rather than always landing on the root. The hash (#services
// etc.) never reaches the server for a static site, so it can't be read
// here — a client script appends the live window.location.hash instead.
const rawPath = Astro.url.pathname.replace(/^\/cardo-ingenium\/?/, "");
const pathWithoutLocale = rawPath.replace(/^(es|de)\/?/, "");

function hrefFor(target: Lang) {
  return `${import.meta.env.BASE_URL}${localizedPath(target, pathWithoutLocale)}`.replace(/\/+/g, "/");
}
---

{variant === "desktop" ? (
  <div class="relative" id="lang-switcher">
    <button
      type="button"
      id="lang-switcher-toggle"
      aria-haspopup="true"
      aria-expanded="false"
      class="inline-flex items-center gap-1.5 text-sm text-[#a9b2bc] hover:text-white transition-colors"
    >
      {lang.toUpperCase()}
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M1 3L5 7L9 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div
      id="lang-switcher-menu"
      class="hidden absolute right-0 top-full mt-2 min-w-[9rem] border border-white/10 bg-[#16202b] py-1 shadow-lg"
    >
      {Object.entries(languages).map(([code, label]) => (
        <a
          href={hrefFor(code as Lang)}
          data-lang-switch-link
          class={`block px-4 py-2 text-sm transition-colors ${code === lang ? "text-[#c9a86a]" : "text-[#a9b2bc] hover:text-white"}`}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
) : (
  <div class="flex items-center gap-4">
    {Object.entries(languages).map(([code, label]) => (
      <a
        href={hrefFor(code as Lang)}
        data-lang-switch-link
        class={`text-sm transition-colors ${code === lang ? "text-[#c9a86a]" : "text-[#a9b2bc] hover:text-white"}`}
      >
        {label}
      </a>
    ))}
  </div>
)}

<script>
  const toggle = document.getElementById("lang-switcher-toggle");
  const menu = document.getElementById("lang-switcher-menu");

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  document.addEventListener("click", () => {
    menu?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  });

  if (window.location.hash) {
    document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch-link]").forEach((link) => {
      const url = new URL(link.href);
      url.hash = window.location.hash;
      link.href = url.href;
    });
  }
</script>
